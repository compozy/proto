# Copied to .env.local by scripts/create.ts; every app and the db scripts read .env.local.

# Local Postgres from docker-compose (`bun run db:up`).
POSTGRES_PORT=5432
DATABASE_URL=postgres://proto:proto@localhost:5432/proto
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

API_URL=http://localhost:3001
APP_URL=http://localhost:3002
VITE_API_URL=http://localhost:3001

# Remote prototype review (disabled until origins and secret are configured).
# Use distinct registrable domains and HTTPS. Never share the review session cookie Domain.
PROTO_PUBLIC_ORIGIN=
PROTO_RENDER_ORIGIN=
# Generate independently: openssl rand -base64 32
PROTO_TICKET_SECRET=
# Comma-separated allowed account emails; empty denies all review sessions.
PROTO_REVIEW_EMAILS=
# Relative to apps/api when started by its package script.
PROTO_GALLERY_DIR=../app/dist-proto
