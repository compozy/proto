{
    "name": "@proto/app",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 3002 --strictPort",
        "build": "vite build && bun run build:gallery && bun run build:storybook",
        "build:gallery": "bun ../../packages/proto/src/cli/main.ts build",
        "build:storybook": "storybook build --quiet",
        "preview": "vite preview --port 3002",
        "storybook": "storybook dev --host 127.0.0.1 --port 6007 --no-open",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:stories": "vitest run --project=storybook-*"
    },
    "dependencies": {
        "@proto/ui": "workspace:*",
        "@tanstack/react-query": "5.104.3",
        "@tanstack/react-router": "1.170.45",
        "better-auth": "1.7.10",
        "openapi-fetch": "0.17.0",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@compozy/proto": "workspace:*",
        "@storybook/addon-a11y": "10.6.2",
        "@storybook/addon-docs": "10.6.2",
        "@storybook/addon-themes": "10.6.2",
        "@storybook/addon-vitest": "10.6.2",
        "@storybook/react-vite": "10.6.2",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "24.19.2",
        "@types/react": "19.2.0",
        "@types/react-dom": "19.2.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/browser-playwright": "5.0.5",
        "@xyflow/react": "12.12.0",
        "oxc-transform-react": "0.154.0",
        "playwright": "1.64.1",
        "storybook": "10.6.2",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    }
}
