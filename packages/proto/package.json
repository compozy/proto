{
    "name": "@compozy/proto",
    "version": "0.1.0",
    "description": "Prototypes from real components, reviewed by people and agents",
    "keywords": [
        "prototypes",
        "react",
        "review",
        "vite"
    ],
    "homepage": "https://github.com/compozy/proto",
    "bugs": {
        "url": "https://github.com/compozy/proto/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/compozy/proto.git",
        "directory": "packages/proto"
    },
    "bin": {
        "proto": "./src/cli/main.ts"
    },
    "files": [
        "dist",
        "src/render",
        "src/model",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": "./src/contract.ts",
        "./flow": "./src/flow.ts",
        "./config": "./src/config.ts",
        "./vite": "./src/vite.ts",
        "./node": "./src/node/index.ts",
        "./server": "./src/server/index.ts",
        "./mcp": "./src/mcp/index.ts"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build": "node scripts/build.mjs",
        "pack": "bun run build && npm pack ./dist/package",
        "test:tarball": "node --test test/e2e/tarball/adoption.test.mjs",
        "prepack": "node scripts/prepack.mjs",
        "build:shell": "vite build -c vite.shell.config.ts",
        "dev:shell": "vite -c test/harness/vite.config.ts"
    },
    "dependencies": {
        "@tanstack/react-query": "5.104.3",
        "@xyflow/react": "12.12.0",
        "citty": "0.2.2",
        "elkjs": "0.12.0",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@base-ui/react": "1.5.0",
        "@fontsource-variable/geist-mono": "5.3.0",
        "@fontsource-variable/inter": "5.3.0",
        "@proto/ui": "workspace:*",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "24.19.2",
        "@types/react": "19.2.0",
        "@types/react-dom": "19.2.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/browser-playwright": "5.0.5",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "oxc-transform-react": "0.154.0",
        "playwright": "1.64.1",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "reicon-react": "1.2.6",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "4.3.3",
        "tsdown": "0.15.12",
        "tw-animate-css": "1.4.0",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "playwright": "1.64.1",
        "postgres": "3.4.9",
        "react": "19.2.0",
        "react-dom": "19.2.0"
    },
    "peerDependenciesMeta": {
        "playwright": {
            "optional": true
        },
        "postgres": {
            "optional": true
        },
        "@modelcontextprotocol/sdk": {
            "optional": true
        }
    },
    "engines": {
        "bun": ">=1.3.0",
        "node": ">=22.14.0"
    }
}
