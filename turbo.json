{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["tsconfig.base.json", ".oxlintrc.json"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".output/**", "dist-proto/**", "storybook-static/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": [],
            "passThroughEnv": ["TEST_DATABASE_URL"]
        },
        "codegen": {
            "cache": false
        },
        "codegen:check": {
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "storybook": {
            "cache": false,
            "persistent": true
        },
        "test:stories": {
            "dependsOn": ["^build"],
            "outputs": []
        }
    }
}
